# Copy this file to .env and set your real values.
# Do not commit .env (it is in .gitignore).

# PostgreSQL connection string (required for the API and for Streamlit if not using .streamlit/secrets.toml)
# Required — Postgres connection string
DATABASE_URL=postgresql://user:password@host:port/database

# "development" (default) or "production"
# Production enforces: CORS_ORIGINS, CLERK_JWT_ISSUER must be set; Swagger docs disabled
APP_ENV=development

# Comma-separated origin allowlist (required in production)
# CORS_ORIGINS=https://app.yourschool.com,https://admin.yourschool.com

# Clerk authentication (required)
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
