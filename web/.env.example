# API base URL — leave empty in dev (Vite proxy handles /api)
# Set to the App Runner URL in staging/production
VITE_API_URL=

# Theme identifier
VITE_THEME=peck

# Clerk authentication (required)
# Get this from https://dashboard.clerk.com → your app → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
